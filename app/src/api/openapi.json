    "/commitments": {
      "get": {
        "summary": "Needs Attention",
        "description": "Open commitments not yet dismissed: unreviewed ones to confirm, confirmed ones to do.",
        "operationId": "needs_attention_commitments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CommitmentItem"
                  },
                  "type": "array",
                  "title": "Response Needs Attention Commitments Get"
                }
              }
            }
          }
        }
      }
    },
