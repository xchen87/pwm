{
  "expo": {
    "name": "Your World",
    "slug": "personal-world-model",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.personalworldmodel.app",
      "associatedDomains": []
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.personalworldmodel.app",
      "intentFilters": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Your World with Face ID."
        }
      ]
    ],
    "scheme": "pwm",
    "extra": {
      "eas": {}
    },
    "_notes": "Fill in before a store build: extra.eas.projectId (from `eas init`), ios.associatedDomains [\"applinks:<api host>\"], android.intentFilters (autoVerify https to <api host> /auth, /brief/*, /assertion/*). The same host must serve /.well-known files: docs/env.md."
  }
}
